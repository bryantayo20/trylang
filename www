      function updateStatus(id,status){setCalls(calls.map(c=>c.id===id?{...c,status}:c));notify(status==='Completed'?'Call marked as completed.':'Call marked as no answer.');}
      return <div className="shell"><aside className="sidebar"><div className="brand"><div className="crest">N</div><div className="brand-copy"><div className="brand-name">NVGCHS</div><div className="brand-sub">Guidance Office</div></div></div><div className="nav-label">Workspace</div><button className="nav-item active"><Icon name="grid"/><span>Overview</span></button><button className="nav-item" onClick={()=>setFilter('All')}><Icon name="phone"/><span>Parent calls</span><span className="nav-count">{calls.filter(c=>c.status==='Pending'||c.status==='Scheduled').length}</span></button><button className="nav-item" onClick={()=>notify('Showing today’s scheduled calls.')}><Icon name="calendar"/><span>Call schedule</span></button><button className="nav-item" onClick={()=>notify('Student directory is ready for the next phase.')}><Icon name="users"/><span>Students</span></button><div className="nav-label">Insights</div><button className="nav-item" onClick={()=>notify('Reports will be available in a future update.')}><Icon name="chart"/><span>Reports</span></button><div className="side-bottom"><div className="counselor"><div className="avatar">GC</div><div><strong>Guidance Counselor</strong><small>NVGCHS • Staff</small></div></div></div></aside>
      <main className="main"><header className="topbar"><div className="crumb">NVGCHS <span style={{padding:'0 7px',color:'#c1cbd2'}}>›</span> <b>Guidance Office</b></div><div className="top-right"><span className="today">{displayDate}</span><button className="bell" aria-label="Notifications" onClick={()=>notify('You’re all caught up.') }><Icon name="bell" size={16}/></button></div></header><section className="page"><div className="welcome"><div><div className="eyebrow">Guidance &amp; counseling</div><h1>Parent Call Center</h1><p>Coordinate family outreach and keep every conversation on track.</p></div><button className="primary" onClick={()=>setModal(true)}><Icon name="plus" size={15}/> New parent call</button></div>
      <div className="metrics"><div className="metric"><div><div className="metric-label">Open notifications</div><div className="metric-value">{calls.filter(c=>c.status==='Pending'||c.status==='Scheduled').length}</div><div className="metric-foot">Needs follow-through</div></div><div className="metric-icon mi-teal"><Icon name="phone"/></div></div><div className="metric"><div><div className="metric-label">Scheduled today</div><div className="metric-value">{calls.filter(c=>c.date==='Oct 14, 2026'&&c.status==='Scheduled').length+1}</div><div className="metric-foot">Across all grade levels</div></div><div className="metric-icon mi-blue"><Icon name="calendar"/></div></div><div className="metric"><div><div className="metric-label">Completed this week</div><div className="metric-value">{calls.filter(c=>c.status==='Completed').length+11}</div><div className="metric-foot">Calls documented</div></div><div className="metric-icon mi-gold"><Icon name="check"/></div></div><div className="metric"><div><div className="metric-label">Follow-up needed</div><div className="metric-value">{calls.filter(c=>c.status==='No answer').length}</div><div className="metric-foot">Parent not reached</div></div><div className="metric-icon mi-red"><Icon name="clock"/></div></div></div>
      <div className="content-grid"><section className="panel"><div className="panel-head"><div><div className="panel-title">Parent call notifications</div><div className="panel-caption">Track and manage family outreach</div></div><button className="view-all" onClick={()=>setFilter('All')}>View all <Icon name="arrow" size={12}/></button></div><div className="toolbar"><div className="search-wrap"><Icon name="search" size={15}/><input className="search" placeholder="Search student, parent, or concern..." value={query} onChange={e=>setQuery(e.target.value)}/></div><select className="filter" value={filter} onChange={e=>setFilter(e.target.value)}><option>All</option><option>Pending</option><option>Scheduled</option><option>Completed</option><option>No answer</option></select></div><div className="table-scroll"><table><thead><tr><th>Student</th><th>Concern</th><th>Call date</th><th>Status</th><th></th></tr></thead><tbody>{filtered.map(c=><tr key={c.id}><td><div className="student"><div className="student-avatar">{c.initials}</div><div><div className="student-name">{c.name}</div><div className="student-meta">{c.grade}</div></div></div></td><td className="reason">{c.reason}</td><td><div className="date">{c.date}</div><div className="student-meta">{c.time}</div></td><td><span className={'status '+(c.status==='Pending'?'s-pending':c.status==='Scheduled'?'s-scheduled':c.status==='Completed'?'s-completed':'s-noanswer')}>{c.status}</span></td><td><select aria-label={'Actions for '+c.name} className="row-action" value="" onChange={e=>e.target.value&&updateStatus(c.id,e.target.value)} style={{fontSize:10,border:0,background:'transparent',width:34}}><option value="">•••</option><option value="Completed">Mark completed</option><option value="No answer">No answer</option><option value="Pending">Set pending</option></select></td></tr>)}{!filtered.length&&<tr><td colSpan="5" className="empty">No call notifications found. Try another search or filter.</td></tr>}</tbody></table></div></section>
      <div className="right-col"><section className="panel"><div className="live-card"><div className="live-top"><div><div className="live-label">Campus local time · Asia/Manila</div><div className="live-time">{liveTime}</div><div className="live-date">{liveDate} · {clockSynced?'Time API synced':'Device time'}</div></div><div className="live-icon">◷</div></div><div className="live-divider"></div><div className="live-label">Current weather</div>{weatherState==='ready'?<><div className="weather-row"><div className="weather-icon">{weather.current.weather_code===0?'☀️':weather.current.weather_code<=3?'🌤️':weather.current.weather_code<60?'☁️':weather.current.weather_code<80?'🌧️':'⛈️'}</div><div><div className="weather-temp">{Math.round(weather.current.temperature_2m)}°C</div><div className="weather-desc">Feels like {Math.round(weather.current.apparent_temperature)}°C · {weather.current.weather_code===0?'Clear':weather.current.weather_code<=3?'Partly cloudy':weather.current.weather_code<60?'Cloudy':weather.current.weather_code<80?'Rain':'Showers'}</div></div><div className="weather-meta">Humidity {weather.current.relative_humidity_2m}%<br/>Wind {Math.round(weather.current.wind_speed_10m)} km/h</div></div><div className="live-foot">{weather.loc.name}{weather.loc.admin1?`, ${weather.loc.admin1}`:''} · Updated just now</div></>:<div className="weather-desc" style={{padding:'12px 0 3px'}}>{weatherState==='loading'?'Loading local weather…':'Weather unavailable. Check the location or connection.'}</div>}<div className="weather-location"><input aria-label="Weather location" value={placeInput} onChange={e=>setPlaceInput(e.target.value)} onKeyDown={e=>e.key==='Enter'&&placeInput.trim()&&setWeatherPlace(placeInput.trim())} placeholder="City or town"/><button onClick={()=>placeInput.trim()&&setWeatherPlace(placeInput.trim())}>Update</button></div></div></section><section className="panel"><div className="panel-head"><div><div className="panel-title">Today’s call schedule</div><div className="panel-caption">Wednesday · October 14</div></div><button className="view-all" onClick={()=>setFilter('Scheduled')}>See calls</button></div><div className="agenda"><div className="agenda-row"><div className="time">9:30 AM</div><div className="agenda-line"></div><div className="agenda-info"><strong>Sofia Reyes’ family</strong><span>Attendance concern</span><div className="agenda-tag">Grade 10 · Narra</div></div></div><div className="agenda-row"><div className="time">10:00 AM</div><div className="agenda-line"></div><div className="agenda-info"><strong>Joshua Cruz’ family</strong><span>Academic follow-up</span><div className="agenda-tag">Grade 8 · Sampaguita</div></div></div><div className="agenda-row"><div className="time">11:15 AM</div><div className="agenda-line"></div><div className="agenda-info"><strong>Andrea Santos’ family</strong><span>Behavioral concern</span><div className="agenda-tag">Grade 9 · Mahogany</div></div></div></div><div className="notice"><div className="notice-label">Counselor reminder</div><p>Document the call outcome and any agreed next steps after each parent conversation.</p></div></section><section className="panel"><div className="panel-head"><div><div className="panel-title">Quick actions</div><div className="panel-caption">Common guidance tasks</div></div></div><div className="quick-grid"><button className="quick" onClick={()=>setModal(true)}><Icon name="phone"/><b>Log a parent call</b><span>Create a new notification</span></button><button className="quick" onClick={()=>{setFilter('No answer');notify('Showing calls needing follow-up.')}}><Icon name="clock"/><b>Follow-up list</b><span>Review missed calls</span></button></div></section></div></div></section></main>
      {modal&&<div className="modal-backdrop" onMouseDown={e=>e.target===e.currentTarget&&setModal(false)}><div className="modal"><div className="modal-head"><div><h2>New parent call</h2><p>Create a confidential family outreach notification.</p></div><button className="close" onClick={()=>setModal(false)}>×</button></div><form className="modal-form" onSubmit={addCall}><div className="field"><label>Student name *</label><input required placeholder="e.g. Juan Dela Cruz" value={form.name} onChange={e=>setForm({...form,name:e.target.value})}/></div><div className="form-row"><div className="field"><label>Grade &amp; section</label><input placeholder="e.g. Grade 9 · Narra" value={form.grade} onChange={e=>setForm({...form,grade:e.target.value})}/></div><div className="field"><label>Reason for call</label><select value={form.reason} onChange={e=>setForm({...form,reason:e.target.value})}><option>Attendance concern</option><option>Academic follow-up</option><option>Behavioral concern</option><option>Guidance referral</option><option>Well-being check-in</option><option>Other</option></select></div></div><div className="field"><label>Parent / guardian</label><input placeholder="Parent or guardian name" value={form.parent} onChange={e=>setForm({...form,parent:e.target.value})}/></div><div className="form-row"><div className="field"><label>Contact number</label><input placeholder="09XX XXX XXXX" value={form.phone} onChange={e=>setForm({...form,phone:e.target.value})}/></div><div className="field"><label>Call date &amp; time</label><input type="date" value={form.date} onChange={e=>setForm({...form,date:e.target.value})}/></div></div><div className="form-row"><div className="field"><label>Scheduled time</label><input type="time" value={form.time} onChange={e=>setForm({...form,time:e.target.value})}/></div><div className="field"><label>Private note (optional)</label><input placeholder="Brief internal reminder"/></div></div><div className="form-actions"><button type="button" className="secondary" onClick={()=>setModal(false)}>Cancel</button><button className="primary" type="submit"><Icon name="plus" size={14}/> Create notification</button></div></form></div></div>}{toast&&<div className="toast">{toast}</div>}</div>;
    }
    ReactDOM.createRoot(document.getElementById('root')).render(<App/>);
  </script>
</body>
</html>
